<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/calibration_instructions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Maintain good posture and press the button to calibrate"
        android:textAppearance="?attr/textAppearanceBody1" />

    <TextView
        android:id="@+id/current_angle_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Current Angle: 0°"
        android:textAppearance="?attr/textAppearanceHeadline6" />

    <Button
        android:id="@+id/set_good_posture_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Set Good Posture" />

    <ProgressBar
        android:id="@+id/calibration_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/saved_angle_range_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Saved Range: 70°-90°"
        android:textAppearance="?attr/textAppearanceBody2" />

    <Button
        android:id="@+id/calibrate_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Calibrate" />

</LinearLayout>