<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".SettingsFragment">

    <Button
        android:id="@+id/start_session_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Start Session" />

    <Button
        android:id="@+id/calibrate_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Calibrate" />

    <TextView
        android:id="@+id/sensitivity_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Sensitivity"
        android:textSize="18sp" />

    <SeekBar
        android:id="@+id/sensitivity_slider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="50" />

    <TextView
        android:id="@+id/tolerance_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Tolerance: 10°"
        android:textSize="18sp" />

    <SeekBar
        android:id="@+id/tolerance_slider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:max="20"
        android:progress="10" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/overlay_mode_switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Overlay Mode" />

</LinearLayout>